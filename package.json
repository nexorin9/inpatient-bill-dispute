{
  "name": "inpatient-bill-dispute",
  "version": "0.1.0",
  "private": true,
  "description": "住院费用争议解释系统 —— 收费员粘贴家属一句疑问，系统按该次住院费用明细逐条给出带依据的解释稿与争议分类",
  "license": "MIT",
  "type": "module",
  "main": "dist/main/main.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node --experimental-strip-types scripts/copy-assets.ts && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "start": "npm run build && node scripts/launch.mjs",
    "capture": "npm run build && node scripts/launch.mjs --capture",
    "cli": "node --experimental-strip-types src/cli/main.ts",
    "fetch:data": "node --experimental-strip-types scripts/fetch-synthea.ts",
    "dict:build": "node --experimental-strip-types scripts/build-dictionaries.ts",
    "copy:assets": "node --experimental-strip-types scripts/copy-assets.ts",
    "lint": "npm run typecheck"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "electron": "^38.8.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
