# 住院费用争议解释系统 · 环境变量样例
# 复制为 .env 后填入本院真实值；.env 已被 .gitignore 排除，不会进仓库。
# 界面与日志只显示「是否已配置」，不回显密钥。

# ── 模型网关（OpenAI-compatible：医院自建端点 / 本地模型 / 云服务共用同一配置面）──
OPENAI_BASE_URL=https://llm.hospital.example.cn/v1
OPENAI_API_KEY=sk-replace-with-real-key
OPENAI_MODEL=qwen2.5-instruct
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_RETRIES=1

# ── HIS 住院费用明细（入站读）──
HIS_BASE_URL=https://his.hospital.example.cn
HIS_API_TOKEN=replace-with-real-token

# ── 本院价目目录（入站读，须带版本号）──
PRICING_BASE_URL=https://pricing.hospital.example.cn
PRICING_API_TOKEN=replace-with-real-token

# ── 科室交办工单（出站写，主路径）──
WORKORDER_BASE_URL=https://workorder.hospital.example.cn
WORKORDER_TOKEN=replace-with-real-token

# ── 院内 IM 群机器人（出站写，仅白名单字段）──
IM_WEBHOOK_URL=https://im.hospital.example.cn/robot/send?key=replace-with-real-key

# ── 归因置信度阈值（低于此值判「需人工判断」，不进外发队列）──
ATTRIBUTION_MIN_CONFIDENCE=0.65
# 阈值附近带宽：落在 ±margin 内也拒答，并保留模型原始分数供人工参考
ATTRIBUTION_CONFIDENCE_MARGIN=0.05

# ── 解释稿长度与引用开关 ──
EXPLANATION_MAX_CHARS=1200
CITATIONS_ENABLED=true

# ── 金额勾稽容差（按分计，默认 0）──
RECONCILIATION_TOLERANCE_CENTS=0

# ── 工单退避重试（仅超时与 5xx）──
WORKORDER_MAX_RETRIES=3
WORKORDER_BACKOFF_MS=100

# ── 咨询超时时限，按渠道可配（分钟）──
SLA_COUNTER_MINUTES=30
SLA_PHONE_MINUTES=60
SLA_ONLINE_MINUTES=240

# ── 本地台账路径（可选；默认 data/ledger.sqlite）──
LEDGER_DB_PATH=
